# Optional. The Supabase connection comes from the committed shared.env, so most people never need this file.
# Use it to point at a different project or to override settings below.
# You create your account and add your own OpenRouter API key in the app.
# Everything else (resumes, cover letter, profile, jobs) is done in the app after you sign in.

# Overrides shared.env (safe to share).
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# Never put the service-role (secret) key here: it bypasses everyone's privacy.

# Your own OpenRouter key: https://openrouter.ai/keys (a typical day costs cents)
# Optional: a key here is used by anyone on this computer who hasn't added their own in the app
# (My files > API key, kept in users/<Name>/keys.json).
OPENROUTER_API_KEY=

# ---- Optional: defaults that work; change only if you want other models --------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Exact model slugs from openrouter.ai/models. FAST = form answers, WRITE = cover letters and essays.
LLM_MODEL_FAST=deepseek/deepseek-v4.1-flash
LLM_MODEL_WRITE=openai/gpt-6-luna
# Hidden "thinking" per model: off | low | medium | high | default. off for FAST keeps answers ~1s.
LLM_REASONING_FAST=off
LLM_REASONING_WRITE=low

# Resume tailoring kicks in below this match (0-1). Match = ATS-style keyword coverage (see README "ATS criteria").
RESUME_MATCH_THRESHOLD=0.80

# Jev: decision model on OpenRouter (same key). Answers form questions from known answers, picks the resume,
# and screens postings. ~typesafe/jev-latest follows new versions.
JEV_MODEL=typesafe/jev-1.13
JEV_URL=https://openrouter.ai/api/alpha/decisions
# Below this confidence a question is left for you instead of answered (0-1).
JEV_MIN_CONFIDENCE=0.6
# 0 turns Jev off entirely.
JEV_ENABLED=1
